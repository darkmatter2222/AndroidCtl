#!/usr/bin/python3 -I
"""Root gateway for the web controller. Deliberately excludes shells and config paths."""
import os
import re
import sys


def validate(args):
    if args == ['check']:
        return
    if not args:
        raise ValueError('Missing operation')
    action = args[0]
    if action == 'config':
        if len(args) == 4 and args[1:3] == ['set', 'max_running_instances'] and args[3].isdigit() and 1 <= int(args[3]) <= 65:
            return
        raise ValueError('Only concurrency configuration is permitted')
    if action == 'doctor' and args[1:] == ['--json']:
        return
    if len(args) < 2 or not re.fullmatch(r'[0-9]{1,5}', args[1]) or not 1 <= int(args[1]) <= 49985:
        raise ValueError('Invalid instance ID')
    rest = args[2:]
    if action in ('start', 'stop', 'restart', 'enable', 'disable') and not rest:
        return
    if action == 'delete' and rest in (['--yes'], ['--yes', '--keep-data']):
        return
    if action in ('info', 'health') and rest == ['--json']:
        return
    if action == 'logs' and rest == ['--since', '30m']:
        return
    if action == 'display' and len(rest) == 2 and rest[0] == '--scale' and rest[1] in ('25', '33', '50', '75', '100'):
        return
    if action == 'renderer' and len(rest) == 2 and rest[0] == '--gpu' and rest[1] in ('host', 'swangle'):
        return
    if action == 'create':
        patterns = {'--api': r'[0-9]{2}', '--ram': r'[0-9]{3,5}', '--cpus': r'[0-9]{1,2}',
                    '--profile': r'[A-Za-z0-9][A-Za-z0-9_.-]{0,100}',
                    '--name': r'[A-Za-z0-9][A-Za-z0-9_.-]{0,100}',
                    '--image': r'[A-Za-z0-9][A-Za-z0-9_.-]{0,100}',
                    '--disk': r'[1-9][0-9]*[GM]', '--display-scale': r'(25|33|50|75|100)'}
        seen = set()
        while rest:
            flag, *rest = rest
            if flag in seen:
                raise ValueError('Duplicate option')
            seen.add(flag)
            if flag == '--runtime-ports':
                continue
            if flag not in patterns or not rest or not re.fullmatch(patterns[flag], rest[0]):
                raise ValueError('Unsupported creation option')
            rest = rest[1:]
        return
    raise ValueError('Operation not permitted by remote gateway')


def main():
    try:
        validate(sys.argv[1:])
        if os.geteuid() != 0:
            raise ValueError('Run through sudo')
        if sys.argv[1:] == ['check']:
            print('AndroidCtl remote management access OK')
            return 0
        os.chdir('/')
        os.execve('/usr/local/bin/androidctl', ['androidctl', *sys.argv[1:]],
                  {'PATH': '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
                   'HOME': '/root', 'LANG': 'C.UTF-8'})
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
